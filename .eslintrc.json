{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true,
    "greasemonkey": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "globals": {
    "unsafeWindow": "readonly"
  },
  "extends": ["eslint:recommended"],
  "rules": {
    "no-empty": ["error", { "allowEmptyCatch": true }],
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-prototype-builtins": "off"
  }
}
